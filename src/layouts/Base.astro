---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { NavId } from "../data/site";
import { documentTitle } from "../data/site";

interface Props {
  op: NavId;
  title: string;
  description: string;
  calendarDev?: boolean;
}

const { op, title, description, calendarDev = false } = Astro.props;
const pageTitle = documentTitle(title);
---

<!doctype html>
<html lang="en" data-op={op} data-calendar-dev={calendarDev ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        var stored = localStorage.getItem("manual-theme");
        var theme = stored === "dark" || stored === "light"
          ? stored
          : (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      } catch (e) {}
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header op={op} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
