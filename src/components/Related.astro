---
import { manualsByIds } from "../data/site";
import ManualCard from "./ManualCard.astro";

interface Props { ids: string[] }
const { ids } = Astro.props;
const others = manualsByIds(ids);
---

{others.length > 0 && (
  <section class="related">
    <div class="wrap">
      <h2>Related</h2>
      <div class="related-grid">
        {others.map((manual) => <ManualCard manual={manual} />)}
      </div>
    </div>
  </section>
)}
