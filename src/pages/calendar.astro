---
import Base from "../layouts/Base.astro";
import CritterCalendar from "../components/CritterCalendar.astro";
import { site } from "../data/site";
import "../styles/calendar.css";
---

<Base
  op="calendar"
  title="Calendar"
  description="Parenting schedule, 5-2-2-5 rotation from Monday 17 August 2026 onward."
  calendarDev={site.calendarDevMode}
>
  <link slot="head" rel="preconnect" href="https://fonts.bunny.net" />
  <link slot="head" rel="stylesheet" href="https://fonts.bunny.net/css2?family=Jost:wght@400;500;600;700&display=swap" />

  <section class="hero wrap">
    <p class="kicker">5-2-2-5</p>
    <h1>Critter Calendar.</h1>
    <p class="lede">
      Mom is pink. Dad is blue. Two weeks through we start anew.
    </p>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap calendar-embed">
      <CritterCalendar />
    </div>
  </section>

  <script is:inline src="/scripts/calendar.js"></script>
</Base>
